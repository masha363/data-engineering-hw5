apiVersion: batch/v1
kind: Job
metadata:
  name: cpu-high
  namespace: hw5
spec:
  backoffLimit: 6
  template:
    metadata:
      labels:
        exp: scheduling
    spec:
      restartPolicy: Never
      priorityClassName: hw5-high
      terminationGracePeriodSeconds: 1
      containers:
        - name: work
          image: skills:1.0
          imagePullPolicy: IfNotPresent
          command: ["sleep", "45"]
          resources:
            requests:
              cpu: @BIG_CPU@
              memory: 32Mi
            limits:
              memory: 64Mi
